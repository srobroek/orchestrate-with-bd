{
	"name": "@srobroek/orchestrate-with-bd",
	"version": "0.7.1",
	"private": true,
	"description": "Durable Beads ledger and role routing on top of native OMP task orchestration.",
	"license": "Apache-2.0",
	"author": {
		"name": "Sjors Robroek"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/srobroek/orchestrate-with-bd"
	},
	"type": "module",
	"engines": {
		"bun": ">=1.3.14"
	},
	"omp": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"devDependencies": {
		"@oh-my-pi/pi-coding-agent": "18.2.1",
		"@oh-my-pi/pi-natives": "18.2.1",
		"@oh-my-pi/pi-utils": "18.2.1",
		"@types/bun": "latest",
		"typescript": "^7.0.0"
	},
	"scripts": {
		"build": "bun build src/index.ts --outdir dist --target bun --external '@oh-my-pi/*'",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	}
}
