node_modules/
*.tsbuildinfo
__pycache__/
*.pyc
.DS_Store
# Beads: track config.yaml so issue-prefix and sync.remote travel.
# Ignore the store and every volatile path; a wrong rule commits a database.
.beads/embeddeddolt/
.beads/dolt/
.beads/backup/
.beads/*.log
.beads/dolt-server.*
.beads/*.db*
.beads.gate.lock
dist/
# Run state, written by readActiveRun's marker and by subagent audit logs. Per-checkout
# and per-run, like .beads/ above: every run of this orchestrator in this repository
# creates it, so leaving it tracked makes the next `git add -A` sweep session state in.
.orchestration/

# OMP project-scope plugin registry (machine-local paths)
.omp/plugins/
*.gate.lock*
